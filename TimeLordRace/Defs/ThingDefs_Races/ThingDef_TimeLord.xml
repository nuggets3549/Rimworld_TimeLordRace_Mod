<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="Human" BS_Alt="ThingDef_AlienRace">
    <defName>TimeLordRace</defName>
    <label>Time Lord</label>
    <description>An ancient, highly advanced alien race from the planet Gallifrey, able to regenerate upon death.</description>
    <statBases>
      <MarketValue>6500</MarketValue>
      <RoyalFavorValue>20</RoyalFavorValue>
            <!-- Good at handing cold and heat. -->
      <ComfyTemperatureMin>-120</ComfyTemperatureMin>
      <ComfyTemperatureMax>850</ComfyTemperatureMax>
    </statBases>

    <race>
      <body>TimeLord</body>
      <lifeExpectancy>1000</lifeExpectancy>
    </race>

    <modExtensions>
      <!-- Required to get the Hediff/tracker added. -->
      <li Class="BigAndSmall.RaceExtension">
        <raceHediff>TimeLordTracker</raceHediff>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
